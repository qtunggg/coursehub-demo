# Copy file này thành backend/.env.docker (KHÔNG commit) rồi điền user/password thật.
# Chỉ khác backend/.env ở DB_HOST: trong container, 127.0.0.1 là chính container Backend,
# còn host.docker.internal mới trỏ ra PostgreSQL đang chạy trên máy host.
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=coursehub
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME
